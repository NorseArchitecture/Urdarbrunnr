<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Norse.Persistence.EntityFramework.Design: DdlEmittingMigrationsScaffolder, AddNorseDesignTimeServices(), and the provider-neutral NorseDesignTimeDbContextFactory base — referenced only by realm *.Migrations.{Provider} projects; never by runtime containers; never connects to a database.</Description>
		<!-- EF Core is not AOT/trim-compatible; override the src-level default. -->
		<IsAotCompatible>false</IsAotCompatible>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.*-*">
			<IncludeAssets>compile</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<ProjectReference Include="../Persistence.EntityFramework/Persistence.EntityFramework.csproj" />
	</ItemGroup>
</Project>
