<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Norse.Persistence.EntityFramework.SqlServer: the SQL Server provider binding (NorseSqlServerEfProvider) — UseSqlServer wiring with the 2025 compatibility-level floor, Aspire enrichment, the temporal history-table rename hook, and the inert design-time placeholder. One sealed class; reference from any host or migrations project targeting SQL Server.</Description>
		<!-- EF Core is not AOT/trim-compatible; override the src-level default. -->
		<IsAotCompatible>false</IsAotCompatible>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.*" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0-rc.2.26504.105" />
		<!-- Transitive via Microsoft.Data.SqlClient 7.1.0 (pinned 9.0.18/10.0.12, GHSA-846f-f764-76mx); drop once SqlClient floors a patched version. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.*-*" />
		<ProjectReference Include="../Persistence.EntityFramework/Persistence.EntityFramework.csproj" />
	</ItemGroup>
</Project>
